{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["ALLOW_TEST_ON_DEV_DATABASE"],
  "globalDependencies": ["tsconfig.base.json", "template.config.ts", "scripts/local-payment-env.*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "env": ["EVIDENCE_DIR"],
      "dependsOn": ["^typecheck", "^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build:node": {
      "dependsOn": ["^build:node"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/template.config.ts",
        "$TURBO_ROOT$/tsconfig.base.json",
        // 插件源码只经生成的注册文件进入构建，不在 apps 的默认输入内（docs/plugins.md）
        "$TURBO_ROOT$/plugins/**",
        "!$TURBO_ROOT$/plugins/*/node_modules/**",
        "$TURBO_ROOT$/scripts/plugins/**",
        "!dist/**",
        "!.output/**",
        "!src/server/cloudflare/**",
        "!wrangler.jsonc"
      ],
      "outputs": [".output/**"],
      "env": ["APP_VERSION"]
    }
  }
}
