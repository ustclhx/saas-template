# D 尚未发布镜像；先用 build.sh 本地构建，所有 app 引用必须使用同一完整40位提交号。
COMPOSE_PROJECT_NAME=saas-selfhost
WEB_IMAGE=saas-selfhost/web:<full-40-character-sha>
JOBS_IMAGE=saas-selfhost/jobs:<full-40-character-sha>
MIGRATE_IMAGE=saas-selfhost/migrate:<full-40-character-sha>
POSTGRES_IMAGE=saas-selfhost/postgres:<full-40-character-sha>
VALKEY_IMAGE=saas-selfhost/valkey:<full-40-character-sha>
CADDY_IMAGE=saas-selfhost/caddy:<full-40-character-sha>
COMPOSE_PROFILES=caddy
APP_DOMAIN=app.example.com
APP_URL=https://app.example.com
ACME_EMAIL=admin@example.com
CADDY_TLS_MODE=acme
CADDY_CERT_DIR=./certs/caddy
PG_TLS_DIR=./certs/postgres
CA_FILE=./certs/ca.crt
SECRETS_DIR=./secrets
POSTGRES_DB=saas_production
CACHE_NAMESPACE=saas-production
DB_POOL_MAX=10
# 同时固定 jobs hostname 与 executor ID；跨重启保留，双副本需各自不同的稳定值并共享 owner 卷。
JOB_EXECUTOR_ID=jobs-1
SHUTDOWN_TIMEOUT_MS=30000
# 只信任此专用 ingress 上的 Caddy；外部代理接入后改成其确切IP/CIDR。
TRUSTED_PROXY_CIDRS=172.30.77.2/32
GOOGLE_CLIENT_ID=<oauth-client-id>
GITHUB_CLIENT_ID=<oauth-client-id>
TURNSTILE_SITE_KEY=<turnstile-site-key>
EMAIL_TRANSPORT=log
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
