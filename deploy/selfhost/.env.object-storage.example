# 额外加载此环境文件和 compose.object-storage.yaml，再显式 --profile object-storage。
# docker build -f deploy/selfhost/object-storage.Dockerfile -t saas-selfhost/object-storage:4.48 .
OBJECT_STORAGE_IMAGE=saas-selfhost/object-storage:4.48
S3_PUBLIC_DOMAIN=objects.example.com
S3_REGION=us-east-1
S3_BUCKET=saas-files
# S3_ENDPOINT 由 override 固定为 https://${S3_PUBLIC_DOMAIN}，应用与浏览器同一地址。
# 独立随机凭据文件：s3_admin_access_key_id / s3_admin_secret_access_key
# 应用凭据文件：s3_access_key_id / s3_secret_access_key（与 admin 均不同）。
# secret 文件必须 UID 1000 可读，父目录0700；不在此文件填写真值。
