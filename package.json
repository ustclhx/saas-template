{
  "name": "saas-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:deps": "node scripts/check-deps.mjs",
    "check:singletons": "node scripts/check-singletons.mjs"
  },
  "devDependencies": {
    "@saas/config": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  }
}
