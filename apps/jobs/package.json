    "@saas/db": "workspace:*",
    "@saas/email": "workspace:*",
    "@saas/entitlements": "workspace:*",
    "@saas/shared": "workspace:*",
    "@saas/storage": "workspace:*",
    "@sentry/cloudflare": "^11.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.5",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@saas/credits": "workspace:*",
    "@types/node": "^22.20.5",
    "drizzle-orm": "^0.45.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  }
