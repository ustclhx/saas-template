{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web",
  // 自定义入口：先校验环境变量，再交给 TanStack Start（src/server.ts）
  "main": "./src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // 本地开发时 localConnectionString 指向主 checkout 的 saas_dev；
  // Orca worktree 中由 vite.config.ts 从 .env.worktree 读取
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE(_CACHED) 覆盖。
  // 顶层 id 为占位值，只用于本地开发；staging 见 env.staging（阶段一，docs/07 §0）。
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://app:app@localhost:5432/saas_dev"
    },
    {
      "binding": "HYPERDRIVE_CACHED",
      "id": "00000000000000000000000000000001",
      "localConnectionString": "postgres://app:app@localhost:5432/saas_dev"
    }
  ],
  // Workflow 定义在 apps/jobs，这里按 script_name 绑定（docs/02-project-structure.md §2）
  "workflows": [
    {
      "name": "ai-media",
      "binding": "AI_MEDIA_WORKFLOW",
      "class_name": "AiMediaWorkflow",
      "script_name": "jobs"
    }
  ],
  // web 为 producer，apps/jobs 为 consumer
  "queues": {
    "producers": [{ "binding": "EMAIL_QUEUE", "queue": "email" }]
  },
  // hyperdrive / workflows / queues 不会从顶层继承，每个环境都要重新声明。
  // 构建时用 CLOUDFLARE_ENV=staging 选择该环境（见 package.json 的 deploy:staging）。
  "env": {
    "staging": {
      "name": "web-staging",
      "hyperdrive": [
        // 本机 PG 的 saas_staging 库，经 Tunnel saas-template-local → Workers VPC 服务 saas-template-local-pg（docs/07 §2）
        { "binding": "HYPERDRIVE", "id": "c4b28441aeaf49c3853a321a39cf8ec4" },
        { "binding": "HYPERDRIVE_CACHED", "id": "1b360caddf134503af774993499bdc4e" }
      ],
      "workflows": [
        {
          "name": "ai-media-staging",
          "binding": "AI_MEDIA_WORKFLOW",
          "class_name": "AiMediaWorkflow",
          "script_name": "jobs-staging"
        }
      ],
      "queues": {
        "producers": [{ "binding": "EMAIL_QUEUE", "queue": "email-staging" }]
      }
    }
  }
}
