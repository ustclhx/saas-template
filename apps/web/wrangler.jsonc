{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web",
  // 自定义入口：先校验环境变量，再交给 TanStack Start（src/server.ts）
  "main": "./src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  // FILES 专用私有桶；顶层由 Miniflare 模拟，预签名配置必须与绑定一致。
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "files" }],
  // 本地开发时 localConnectionString 指向主 checkout 的 saas_dev；
  // Orca worktree 中由 vite.config.ts 从 .env.worktree 读取
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE(_CACHED) 覆盖。
  // 顶层 id 为占位值，只用于本地开发；staging 见 env.staging（阶段一，docs/07 §0）。
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://app:app@localhost:5432/saas_dev"
    },
    {
      "binding": "HYPERDRIVE_CACHED",
      "id": "00000000000000000000000000000001",
      "localConnectionString": "postgres://app:app@localhost:5432/saas_dev"
    }
  ],
  // Workflow 定义在 apps/jobs，这里按 script_name 绑定（docs/02-project-structure.md §2）
  "workflows": [
    {
      "name": "ai-media",
      "binding": "AI_MEDIA_WORKFLOW",
      "class_name": "AiMediaWorkflow",
      "script_name": "jobs"
    }
  ],
  // web 为 producer，apps/jobs 为 consumer
  "queues": {
    "producers": [
      { "binding": "EMAIL_QUEUE", "queue": "email" },
      { "binding": "EVENTS_QUEUE", "queue": "events" }
    ]
  },
  // Better Auth 会话的 secondaryStorage（packages/auth/src/session.ts）；本地由 Miniflare 模拟，id 为占位值
  "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000002" }],
  // 认证入口按 IP + 邮箱限流（packages/auth/src/protection.ts）：每个 key 每 60 秒 10 次；
  // AI 接口按空间 + 用户限流（features/ai/chat.ts）：每个 key 每 60 秒 20 次，只用于防刷；本地由 Miniflare 模拟
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_AI", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_API", "namespace_id": "1005", "simple": { "limit": 60, "period": 60 } }
  ],
  // 本地开发的站点地址；`vite dev` 时由 vite.config.ts 按 .env.worktree 的端口覆盖。
  // TURNSTILE_SITE_KEY 为 Cloudflare 官方测试 site key（始终通过），与 .dev.vars 中的测试 secret 配对
  "vars": {
    "SENTRY_ENVIRONMENT": "development",
    "PAYMENT_MODE": "test",
    "APP_URL": "http://localhost:3000",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "R2_FILES_BUCKET": "files"
  },
  // hyperdrive / workflows / queues / kv_namespaces / ratelimits / vars 不会从顶层继承，每个环境都要重新声明。
  // staging 认证使用独立 KV、限流命名空间和官方 Turnstile 测试 key。
  // staging 测试认证 secrets 已通过 wrangler secret bulk 配置；OAuth 使用 mock，真实联调前替换。
  // 构建时用 CLOUDFLARE_ENV=staging 选择该环境（见 package.json 的 deploy:staging）。
  "env": {
    "staging": {
      "name": "web-staging",
      "ai": { "binding": "AI" },
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "files-staging" }],
      "vars": {
        "SENTRY_ENVIRONMENT": "staging",
        "AI_FAULT_INJECTION": "enabled",
        "PAYMENT_MODE": "test",
        "APP_URL": "https://web-staging.saas-jobs.workers.dev",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "AI_GATEWAY_ACCOUNT_ID": "170a06d37ad50396b19943eb6b77a21d",
        "AI_GATEWAY_ID": "saas-staging",
        // Gateway 整段缓冲 DeepSeek SSE（#152）；有 DEEPSEEK_API_KEY secret 时直连，缺失时仍走 Gateway。
        "AI_TEXT_EGRESS": "direct",
        "R2_ACCOUNT_ID": "170a06d37ad50396b19943eb6b77a21d",
        "R2_FILES_BUCKET": "files-staging"
      },
      "kv_namespaces": [{ "binding": "CACHE", "id": "f4d49b7c082b4f01ae20335683d3a21b" }],
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_AI", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_API", "namespace_id": "1006", "simple": { "limit": 60, "period": 60 } }
      ],
      "hyperdrive": [
        // Neon saas_staging，app 非 pooled TLS 直连；分别关闭缓存与缓存 60 秒（docs/07 §2）
        { "binding": "HYPERDRIVE", "id": "b3a797e705e849a196a4f7fcaf887293" },
        { "binding": "HYPERDRIVE_CACHED", "id": "ad4f2267382b427fbdd2ffe60d3a64de" }
      ],
      "workflows": [
        {
          "name": "ai-media-staging",
          "binding": "AI_MEDIA_WORKFLOW",
          "class_name": "AiMediaWorkflow",
          "script_name": "jobs-staging"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "EMAIL_QUEUE", "queue": "email-staging" },
          { "binding": "EVENTS_QUEUE", "queue": "events-staging" }
        ]
      }
    },
    // add-cloud-production-neon 2.1：生产资源与 staging 一一对应，不复用任何 staging ID（production runbook §8.B）。
    // 不设 PAYMENT_MODE（Q9 前支付关闭）与 AI_FAULT_INJECTION（生产禁止）；Turnstile 站点 saas-production 仅允许本项目的生产域名。
    "production": {
      "name": "web-production",
      "observability": { "enabled": true, "head_sampling_rate": 1, "traces": { "enabled": false } },
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "app.ezarouter.cc", "custom_domain": true }],
      "ai": { "binding": "AI" },
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "files-production" }],
      "vars": {
        "SENTRY_ENVIRONMENT": "production",
        "APP_URL": "https://app.ezarouter.cc",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFXeXLLV-NITAkGX",
        "AI_TEXT_EGRESS": "direct",
        "R2_ACCOUNT_ID": "170a06d37ad50396b19943eb6b77a21d",
        "R2_FILES_BUCKET": "files-production"
      },
      "kv_namespaces": [{ "binding": "CACHE", "id": "76d4f2b69b1a45db8fe1c0a66eaf9b34" }],
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "1007", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_AI", "namespace_id": "1008", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_API", "namespace_id": "1009", "simple": { "limit": 60, "period": 60 } }
      ],
      "hyperdrive": [
        // Neon saas_production，app 非 pooled TLS 直连；分别关闭缓存与默认缓存
        { "binding": "HYPERDRIVE", "id": "0519ee8f8e5b4f0f95ecd9d425c58a36" },
        { "binding": "HYPERDRIVE_CACHED", "id": "3deaa579109549f9a06f12b6c8d4aae6" }
      ],
      "workflows": [
        {
          "name": "ai-media-production",
          "binding": "AI_MEDIA_WORKFLOW",
          "class_name": "AiMediaWorkflow",
          "script_name": "jobs-production"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "EMAIL_QUEUE", "queue": "email-production" },
          { "binding": "EVENTS_QUEUE", "queue": "events-production" }
        ]
      }
    }
  }
}
