{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // 与 tsconfig.json 相同：插件代码经 @web/* 访问 web 核心模块
    "paths": {
      "content-collections": ["./.content-collections/generated"],
      "@web/*": ["./src/*"]
    }
  },
  "include": [
    "test",
    "src/env.d.ts",
    "e2e/staging-acceptance/local-media.ts",
    "e2e/staging-acceptance/fault-local-media.ts",
    "src/version.d.ts"
  ],
  "exclude": ["test/global-setup.ts"]
}
